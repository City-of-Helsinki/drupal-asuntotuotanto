{#
/**
 * @file
 * Default theme implementation to display a paragraph.
 *
 * Available variables:
 * - paragraph: Full paragraph entity.
 *   Only method names starting with "get", "has", or "is" and a few common
 *   methods such as "id", "label", and "bundle" are available. For example:
 *   - paragraph.getCreatedTime() will return the paragraph creation timestamp.
 *   - paragraph.id(): The paragraph ID.
 *   - paragraph.bundle(): The type of the paragraph, for example, "image" or "text".
 *   - paragraph.getOwnerId(): The user ID of the paragraph author.
 *   See Drupal\paragraphs\Entity\Paragraph for a full list of public properties
 *   and methods for the paragraph object.
 * - content: All paragraph items. Use {{ content }} to print them all,
 *   or print a subset such as {{ content.field_example }}. Use
 *   {{ content|without('field_example') }} to temporarily suppress the printing
 *   of a given child element.
 * - attributes: HTML attributes for the containing element.
 *   The attributes.class element may contain one or more of the following
 *   classes:
 *   - paragraphs: The current template type (also known as a "theming hook").
 *   - paragraphs--type-[type]: The current paragraphs type. For example, if the paragraph is an
 *     "Image" it would result in "paragraphs--type--image". Note that the machine
 *     name will often be in a short form of the human readable label.
 *   - paragraphs--view-mode--[view_mode]: The View Mode of the paragraph; for example, a
 *     preview would result in: "paragraphs--view-mode--preview", and
 *     default: "paragraphs--view-mode--default".
 * - view_mode: View mode; for example, "preview" or "full".
 * - logged_in: Flag for authenticated user status. Will be true when the
 *   current user is a logged-in member.
 * - is_admin: Flag for admin user status. Will be true when the current user
 *   is an administrator.
 *
 * @see template_preprocess_paragraph()
 *
 * @ingroup themeable
 */
#}
{%
  set classes = [
  'latest-news',
  view_mode ? 'latest-news--' ~ view_mode|clean_class,
  not paragraph.isPublished() ? 'latest-news--unpublished'
]
%}
{% block paragraph %}
  {% set title = content.field_title.0 %}
  {% set highlight_projects = homepage_highlight_projects ?? [] %}

  {% block homepage_highlights %}
    {% if highlight_projects is not empty %}
      <section class="showcase-block showcase-block--homepage-highlights" aria-label="{{ 'Highlighted projects'|t }}">
        <div class="showcase-block__content" style="background-color: transparent; padding: 0;">
          <ul class="showcase-block__showcases showcases-count--{{ highlight_projects|length }}">
            {% for project in highlight_projects %}
              {% set panel_bg = 'var(--color-engel)' %}
              {% if project.type_class == 'haso' %}
                {% set panel_bg = 'var(--color-copper-medium-light)' %}
              {% elseif project.type_class == 'puolihitas' %}
                {% set panel_bg = 'var(--color-engel-light)' %}
              {% endif %}
              <li class="showcase" style="height: 600px; max-height: 600px; overflow: hidden;">
                <a class="liftup-with-image-and-links liftup-with-image-and-links--design-image-on-left" href="{{ project.url }}" style="display: block; height: 100%; max-height: 100%; overflow: hidden; position: relative;">
                  <div class="liftup-with-image-and-links__image" style="height: 100%;">
                    <img src="{{ project.image_url }}" alt="{{ project.image_alt }}" loading="lazy" style="display: block; width: 100%; height: 100%; object-fit: cover; object-position: center;" />
                  </div>
                  <div class="liftup-with-image-and-links__container">
                    <div class="liftup-with-image-and-links__content" style="background-color: {{ panel_bg }}; padding: 24px; min-height: 0; left: auto; right: 0; top: 10%; transform: none; width: 40%;">
                      {% if project.type_label %}
                        <p class="project__ownership-type project__ownership-type--{{ project.type_class|default('hitas') }}">
                          <span class="visually-hidden">({{ 'Ownership type'|t }})</span>
                          {{ project.type_label }}
                        </p>
                      {% endif %}
                      <h3 class="liftup-with-image-and-links__title" style="font-size: 1.75rem; margin-bottom: 12px;">{{ project.text }}</h3>
                      <div class="liftup-with-image-and-links__desc">
                        <p class="project__address">{{ project.title }}</p>
                      </div>
                    </div>
                  </div>
                </a>
              </li>
            {% endfor %}
          </ul>
        </div>
      </section>
    {% endif %}
  {% endblock %}

  <div{{ attributes.addClass(classes) }}>
    {% block container_content %}
    <div class="latest-news__content">
      <div class="latest-news__header">
        <h2 class="latest-news__title">{{ title ?: 'News'|t }}</h2>
        {{ link('View all news'|t, 'internal:/news', { 'class': 'latest-news__link'} ) }}
      </div>
      {{ drupal_block('views_block:news-latest_news_block') }}
    </div>
    {% include '@hdbt/misc/koro.twig' with {koro: koro, flip: false, color: 'white' } %}
    {% endblock %}
  </div>
{% endblock paragraph %}

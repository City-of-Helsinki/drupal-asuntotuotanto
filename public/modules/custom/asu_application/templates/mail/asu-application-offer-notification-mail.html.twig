{% autoescape false %}
{% if action == 'accepted' %}
{% trans %}A customer has accepted an apartment offer.{% endtrans %}
{% elseif action == 'rejected' %}
{% trans %}A customer has rejected an apartment offer.{% endtrans %}
{% else %}
{% trans %}A customer has not yet responded to an apartment offer before the deadline.{% endtrans %}
{% endif %}

{% trans %}Project{% endtrans %}: {{ project_name }}
{% trans %}Apartment{% endtrans %}: {{ apartment_number }}
{% trans %}Customer{% endtrans %}: {{ customer_name }} ({{ customer_email }})
{% trans %}Offer valid until{% endtrans %}: {{ valid_until }}
{% endautoescape %}

msgstr "Uusi vastaus hakemukseesi @id"

msgid "Sales agent replied to your message in the application service."
msgstr "Myyjä vastasi viestiisi hakemuspalvelussa."

msgid "The message was saved, but no salesperson email address was found."
msgstr "Viesti tallennettiin, mutta myyjän sähköpostiosoitetta ei löytynyt."

msgid "Your message has been sent."
msgstr "Viestisi on lähetetty."

msgid "Message sales agent"
msgstr "Lähetä viesti myyjälle"

msgstr "Lähetä viesti kohteesta @project. Vastaukset tallennetaan tähän viestiketjuun."

msgid "Send a message to the sales agent assigned to this application."
msgstr "Lähetä viesti tälle hakemukselle nimetylle myyjälle."

msgid "Back to application"
msgstr "Takaisin hakemukseen"

msgid "Conversation"
msgstr "Viestiketju"

msgid "No messages yet."
msgstr "Ei viestejä vielä."

msgid "Sales agent"
msgstr "Myyjä"

msgid "You"
msgstr "Sinä"

msgid "Message cannot be empty."
msgstr "Viesti ei voi olla tyhjä."

msgid "New message about application @id"
msgstr "Uusi viesti hakemuksesta @id"

msgid "A customer sent a new message from the application service."
msgstr "Asiakas lähetti uuden viestin hakemuspalvelusta."

msgid "Project: @project"
msgstr "Kohde: @project"

msgid "Application ID: @id"
msgstr "Hakemuksen tunnus: @id"

msgid "Message:"
msgstr "Viesti:"

msgid "Customer message thread: @url"
msgstr "Asiakkaan viestiketju: @url"

msgid "Salesperson message thread: @url"
msgstr "Myyjän viestiketju: @url"

